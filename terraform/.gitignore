# Local .terraform directory (contains binaries and plugins)
.terraform/

# Terraform state files (crucial to ignore as they contain secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (usually contain sensitive data)
*.tfvars
*.tfvars.json

# Ignore transient lock files
.terraform.tfstate.lock.info

# Ignore Terraform plan files (often contain sensitive data)
*.tfplan

*.terraform.lock.hcl